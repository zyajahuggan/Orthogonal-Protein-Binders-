# Large, regenerable model inputs/outputs -- not suitable for git/GitHub
benchmark_orthog_prot/*/inputs/
benchmark_orthog_prot/*/outputs/

# Slurm job logs -- regenerable, not source
benchmark_orthog_prot/*/logs/

# PDB structure files -- regenerable model outputs, not source
*.pdb

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code local config/notes -- not project code
.claude/
CLAUDE.local.md

# Editor cruft -- personal config/temp files, not source
.vscode/
*.swp
