<ROSETTASCRIPTS>
    <SCOREFXNS>
        <ScoreFunction name="ref15" weights="ref2015"/>
    </SCOREFXNS>

    <RESIDUE_SELECTORS>
        <True name="all" />

        <!-- Select interface residues within 8A of the other chain -->
        <Chain name="chainA" chains="A"/>
        <Chain name="chainB" chains="B"/>

        <Neighborhood name="A_near_B" selector="chainB" distance="8.0"/>
        <Neighborhood name="B_near_A" selector="chainA" distance="8.0"/>

        <!-- Interface = residues on each chain near the other -->
        <And name="interfaceA" selectors="chainA,A_near_B"/>
        <And name="interfaceB" selectors="chainB,B_near_A"/>
        <Or  name="interface"  selectors="interfaceA,interfaceB"/>

        <!-- Non-interface = everything else, stays frozen -->
        <Not name="non_interface" selector="interface"/>
    </RESIDUE_SELECTORS>

    <TASKOPERATIONS>
        <InitializeFromCommandline name="init" />
        <IncludeCurrent name="current" />
        <LimitAromaChi2 name="limitchi2" chi2max="110" chi2min="70" include_trp="True" />
        <ExtraRotamersGeneric name="ex1_ex2" ex1="1" ex2="1" />
        <OperateOnResidueSubset name="restrict2repacking" selector="all">
            <RestrictToRepackingRLT/>
        </OperateOnResidueSubset>
    </TASKOPERATIONS>

    <MOVERS>
        <FastRelax name="FastRelax" scorefxn="ref15"
            cartesian="false" bondangle="false" bondlength="false"
            min_type="dfpmin_armijo_nonmonotone"
            task_operations="init,current,ex1_ex2,limitchi2,restrict2repacking"
            relaxscript="InterfaceDesign2019"
            repeats="5">
            <MoveMap name="MM">
                <!-- Interface residues: BB + SC mobile -->
                <ResidueSelector selector="interface"  bb="true" chi="true"/>
                <!-- Everything else: SC only -->
                <ResidueSelector selector="non_interface" bb="false" chi="true"/>
                <!-- Keep chains from drifting apart -->
                <Jump number="1" setting="false"/>
            </MoveMap>
        </FastRelax>

        <InterfaceAnalyzerMover name="analyze_interface"
            scorefxn="ref15"
            interface="A_B"
            pack_separated="1"
            packstat="true"/>
    </MOVERS>

    <PROTOCOLS>
        <Add mover="FastRelax"/>
        <Add mover="analyze_interface"/>
    </PROTOCOLS>

    <OUTPUT scorefxn="ref15"/>
</ROSETTASCRIPTS>